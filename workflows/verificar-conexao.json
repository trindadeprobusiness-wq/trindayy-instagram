      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json;const p=r.body||{};if(r.statusCode!==200||p.error){const e=p.error||{};return [{json:{conectado:false,http_status:r.statusCode,codigo:e.code||null,subcodigo:e.error_subcode||null,motivo:String(e.message||\"Falha na consulta\").replace(/Bearer\\s+\\S+/gi,\"Bearer [REDACTED]\").replace(/IG[A-Za-z0-9_-]{30,}/g,\"[REDACTED]\").slice(0,400)}}];}const id=String(p.user_id||\"\");if(p.username?.toLowerCase()!==\"trindayy\"||!/^\\d{5,30}$/.test(id))return [{json:{conectado:false,motivo:\"Identidade não corresponde ao @trindayy ou user_id ausente\",username:p.username||\"\",user_id:id}}];return [{json:{conectado:true,username:p.username,ig_user_id:id,http_status:r.statusCode,api:\"instagram_login\",publicacao_testada:false}}];"
      }
