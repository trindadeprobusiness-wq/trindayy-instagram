{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Calendário de lotes Trindayy",
  "type": "object",
  "required": ["version", "account", "timezone", "lotes"],
  "properties": {
    "version": { "const": 1 },
    "account": { "const": "trindayy" },
    "timezone": { "const": "America/Sao_Paulo" },
    "lotes": { "type": "array", "items": { "$ref": "#/$defs/lote" } }
  },
  "$defs": {
    "lote": {
      "type": "object", "required": ["id", "posts"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{3,100}$" },
        "inicio": { "type": "string", "format": "date" },
        "posts": { "type": "array", "items": { "$ref": "#/$defs/post" } }
      }
    },
    "post": {
      "type": "object", "required": ["id", "versao", "tipo", "ig_media_type", "legenda", "status", "midias"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{3,100}$" },
        "versao": { "type": "string", "minLength": 1 },
        "tipo": { "const": "FEED" },
        "ig_media_type": { "enum": ["IMAGE", "REELS", "CAROUSEL"] },
        "tema": { "type": "string" },
        "legenda": { "type": "string", "minLength": 1, "maxLength": 2200 },
        "status": { "enum": ["rascunho", "em_revisao", "pronto_para_postar"] },
        "trello_url": { "type": "string", "format": "uri" },
        "aprovacao": { "type": "object", "required": ["por", "em", "versao"], "properties": { "por": { "const": "Gabriel" }, "em": { "type": "string", "format": "date-time" }, "versao": { "type": "string" } } },
        "midias": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "object", "required": ["ordem", "sha256"], "properties": { "ordem": { "type": "integer", "minimum": 1, "maximum": 10 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "url_publica": { "type": "string", "format": "uri" }, "caminho_post": { "type": "string" }, "caminho_projeto": { "type": "string" } }, "anyOf": [{ "required": ["url_publica"] }, { "required": ["caminho_post"] }, { "required": ["caminho_projeto"] }] } }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "pronto_para_postar" } } }, "then": { "required": ["aprovacao"] } },
        { "if": { "properties": { "ig_media_type": { "const": "CAROUSEL" } } }, "then": { "properties": { "midias": { "minItems": 2 } } }, "else": { "properties": { "midias": { "maxItems": 1 } } } }
      ]
    }
  }
}
